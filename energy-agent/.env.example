# Copy to .env (never commit .env)
MOCK_LLM=true                      # true = no model needed (keyword router + template answers)
LLM_PROVIDER=anthropic             # anthropic | openai | gemini | groq | ollama
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
PLANT_TZ=Asia/Kolkata
EMISSION_FACTOR=0.4
